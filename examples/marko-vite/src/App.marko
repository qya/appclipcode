import { init, get_templates } from "./lib/appclipcode.js";

<let/url = "https://example.com">
<let/templateIndex = 0>
<let/codeType = "cam">
<let/templates = []>

<lifecycle
  async onMount() {
    await init();
    try {
      templates = get_templates();
    } catch (e) {
      console.error(e);
    }
  }
/>

<div class="container">
  <header class="header">
    <div class="badge">Marko.js + Vite + Rust WASM</div>
    <h1>Apple App Clip Code Generator & Decoder</h1>
    <p class="subtitle">
      Reactive Marko components powered by pure WebAssembly compiled from Rust.
    </p>
  </header>

  <main class="grid">
    <!-- Left Column: Generator Form & Controls -->
    <section class="card controls-card">
      <h2>Generate Code</h2>

      <div class="form-group">
        <label for="url-input">Payload URL (must start with https://)</label>
        <input
          id="url-input"
          class="input-field"
          type="url"
          value:=url
          placeholder="https://example.com"
        />
      </div>

      <div class="form-group">
        <label for="type-select">Code Design</label>
        <div class="segmented-control">
          <button
            class={ active: codeType === "cam" }
            onClick() { codeType = "cam" }
          >
            Camera Code
          </button>
          <button
            class={ active: codeType === "nfc" }
            onClick() { codeType = "nfc" }
          >
            NFC Tap Code
          </button>
        </div>
      </div>

      <div class="form-group">
        <label for="template-select">Color Template</label>
        <select
          id="template-select"
          class="select-field"
          value=templateIndex
          onChange(e) { templateIndex = parseInt(e.target.value, 10) || 0 }
        >
          <for|t| of=templates>
            <option value=t.index>
              Template ${t.index} (${t.foreground} on ${t.background})
            </option>
          </for>
        </select>
      </div>

      <div class="quick-links">
        <span class="label">Sample URLs:</span>
        <button class="chip" onClick() { url = "https://apple.com" }>
          apple.com
        </button>
        <button class="chip" onClick() { url = "https://appclip.apple.com/id?p=com.example.clip" }>
          App Clip URL
        </button>
        <button class="chip" onClick() { url = "https://app.nextdns.io" }>
          nextdns.io
        </button>
      </div>
    </section>

    <!-- Center/Right: Visual Preview Component -->
    <section class="card preview-card">
      <h2>Live Component</h2>
      <appclip-code
        url=url
        template=templateIndex
        codeType=codeType
        size=320
      />
    </section>

    <!-- Bottom Full Width: Decoder Component -->
    <section class="full-width">
      <appclip-decoder />
    </section>
  </main>
</div>

<style>
