    max-width: 1040px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  .header {
    text-align: center;
    margin-bottom: 40px;
  }

  .badge {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
    letter-spacing: 0.3px;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
  }

  .subtitle {
    font-size: 1.05rem;
    color: #6e6e73;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .card {
    background: #ffffff;
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid #eaeaea;
  }

  .card h2 {
    font-size: 1.3rem;
    margin: 0 0 20px;
    font-weight: 600;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: #333;
  }

  .input-field,
  .select-field {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    font-size: 0.95rem;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    outline: none;
    transition: border-color 0.2s ease;
    background: #fff;
  }

  .input-field:focus,
  .select-field:focus {
    border-color: #0071e3;
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
  }

  .segmented-control {
    display: flex;
    background: #eef1f4;
    padding: 4px;
    border-radius: 10px;
